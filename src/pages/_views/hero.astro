---
import { ArrowRightIcon, MapPinIcon } from "lucide-react";
import { MaskedHeading } from "@/components/typography/masked-heading";

import abhay from "@/assets/images/home/abhay.jpg";
import shiv from "@/assets/images/review/ShivKamdar.png";
---

<section id="hero" class="flex flex-col gap-16">
  <div class="container">
    <div class="flex flex-col items-center">
      <div class="animate-slide-in opacity-0 inline-flex items-center gap-2 px-4 py-2 mb-10 rounded-full ring-1 ring-white/10 bg-white/5 backdrop-blur-sm">
        <MapPinIcon className="h-4 w-4 text-[#c257ff]" />
        <span class="text-sm font-medium text-foreground/90">Based in Singapore</span>
      </div>
      <MaskedHeading className="animate-slide-in [--slide-in-delay:75ms] opacity-0 whitespace-nowrap text-4xl sm:text-6xl lg:text-7xl xl:text-[5rem] leading-[1.1]"
        >Build for what comes next.</MaskedHeading
      >
      <p class="animate-slide-in [--slide-in-delay:150ms] opacity-0 text-foreground/80 max-w-2xl text-center text-lg font-normal mt-16 mb-20">
        We elevate your business through custom websites, applications, branding and more.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-6 animate-slide-in [--slide-in-delay:250ms] opacity-0">
        <div class="relative group/button">
          <div
            class="absolute transition-all duration-150 opacity-0 inset-px bg-[#c257ff] rounded-xl blur-lg group-hover/button:opacity-60 group-hover/button:-inset-px group-hover/button:duration-300 z-0"
          >
          </div>
          <a
            class="h-14 inline-flex items-center px-10 py-2 bg-[#c257ff] font-semibold rounded-full text-background relative z-10"
            href="/contact">Get in touch</a
          >
        </div>
        <a class="inline-flex items-center gap-2 group" href="/services">
          <span class="font-medium">View our services</span>
          <div class="h-6 w-6 overflow-hidden">
            <div class="flex transition-transform duration-500 -translate-x-6 group-hover:translate-x-0">
              <ArrowRightIcon className="h-6 w-6 -rotate-45 shrink-0" />
              <ArrowRightIcon className="h-6 w-6 -rotate-45 shrink-0" />
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
  <div class="container max-w-6xl mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
      <div class="animate-slide-in [--slide-in-delay:350ms] opacity-0 lg:col-span-2 relative">
        <div class="absolute inset-0 -m-6 bg-[#c257ff]/20 rounded-3xl blur-3xl"></div>
        <img
          src={abhay.src}
          alt="Abhay, Founder of NodeFlux"
          class="relative w-full aspect-square object-cover rounded-3xl ring-1 ring-white/10"
        />
      </div>
      <div class="animate-slide-in [--slide-in-delay:500ms] opacity-0 lg:col-span-3 flex flex-col gap-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c257ff] mb-3">A note from the founder</p>
          <h2 class="text-3xl sm:text-4xl font-semibold leading-tight">
            Built by a Singapore founder who actually picks up the phone.
          </h2>
        </div>
        <p class="text-foreground/75 text-lg leading-relaxed">
          I'm Abhay. I started NodeFlux because too many local businesses get handed cookie-cutter templates and ghosted after launch.
          Whether you need a website, an app, or full branding, you work directly with me from kickoff to handover. No agency layers, no
          vague timelines, just clear work and honest pricing.
        </p>
        <div class="bg-card border rounded-xl p-6 flex flex-col gap-4 mt-2">
          <p class="italic text-foreground/85">
            “They turned our digital vision into reality with an impressive website that just WOWs our customers”
          </p>
          <div class="flex items-center gap-4">
            <img src={shiv.src} alt="Shiv Kamdar" class="h-10 w-10 rounded-full object-cover" />
            <div class="text-sm flex flex-col gap-0.5">
              <strong>Shiv Kamdar</strong>
              <span class="text-foreground/60">Founder of Shiv Kamdar Events</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
