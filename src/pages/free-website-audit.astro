---
import Layout from "@/layouts/layout.astro";
import { MaskedHeading } from "@/components/typography/masked-heading";
import { GaugeIcon, SmartphoneIcon, SearchIcon, MessageSquareIcon } from "lucide-react";

const steps = [
  {
    title: "Send us your website address",
    description: "Use the contact form and tell us a little about your business and what you want the site to do for it.",
  },
  {
    title: "We review it",
    description: "We go through the site the way a customer would, then look at what is happening under the hood.",
  },
  {
    title: "You get a written report",
    description:
      "A detailed report on what's working and what could be better. What you do with it is up to you: fix it yourself, pass it to your current developer, or ask us for a quote.",
  },
];
---

<Layout
  title="Free Website Audit for Singapore Businesses | NodeFlux Pte. Ltd."
  description="Get a free audit of your business website. We review speed, mobile experience, search visibility and how clearly it sells, then send you a written report. No pressure to pay."
>
  <section id="audit-hero">
    <div class="container">
      <div class="flex flex-col items-center max-w-3xl mx-auto">
        <div class="animate-slide-in opacity-0 inline-flex items-center gap-2 px-4 py-2 mb-10 rounded-full ring-1 ring-white/10 bg-white/5 backdrop-blur-sm">
          <SearchIcon className="h-4 w-4 text-[#c257ff]" />
          <span class="text-sm font-medium text-foreground/90">Free for a limited time</span>
        </div>
        <MaskedHeading className="animate-slide-in [--slide-in-delay:75ms] opacity-0 text-4xl sm:text-5xl lg:text-6xl leading-[1.1]">
          Free website audit for Singapore businesses.
        </MaskedHeading>
        <p class="animate-slide-in [--slide-in-delay:150ms] opacity-0 text-foreground/75 text-center text-lg font-normal mt-10">
          We'll review your site and send back a detailed report on what's working and what could be better. No hidden
          charges. No pressure to pay.
        </p>
        <div class="relative group/button mt-10 animate-slide-in [--slide-in-delay:250ms] opacity-0">
          <div
            class="absolute transition-all duration-150 opacity-0 inset-px bg-[#c257ff] rounded-xl blur-lg group-hover/button:opacity-60 group-hover/button:-inset-px group-hover/button:duration-300 z-0"
          >
          </div>
          <a
            href="/contact/?subject=Free+Website+Audit"
            class="h-14 inline-flex items-center px-10 py-2 bg-[#c257ff] font-semibold rounded-full text-background relative z-10"
          >
            Claim My Free Audit
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="audit-checks" class="mt-24 sm:mt-32">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-semibold leading-tight text-center">What we look at</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
          <article class="bg-card rounded-2xl border p-8 flex flex-col gap-3">
            <GaugeIcon className="h-6 w-6 text-[#03cc00]" />
            <h3 class="text-xl font-semibold">Speed</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">How long your pages take to load, and what is slowing them down.</p>
          </article>
          <article class="bg-card rounded-2xl border p-8 flex flex-col gap-3">
            <SmartphoneIcon className="h-6 w-6 text-[#6eaaff]" />
            <h3 class="text-xl font-semibold">Mobile experience</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">Whether the site is easy to read, tap and navigate on a phone.</p>
          </article>
          <article class="bg-card rounded-2xl border p-8 flex flex-col gap-3">
            <SearchIcon className="h-6 w-6 text-[#c257ff]" />
            <h3 class="text-xl font-semibold">Search visibility</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">Whether Google can find and understand your pages, and what is holding them back in search results.</p>
          </article>
          <article class="bg-card rounded-2xl border p-8 flex flex-col gap-3">
            <MessageSquareIcon className="h-6 w-6 text-[#B73DFC]" />
            <h3 class="text-xl font-semibold">Clarity</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">Whether a new visitor can quickly tell what you do, why they should trust you, and how to contact you.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="audit-steps" class="mt-24 sm:mt-32">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-semibold leading-tight text-center">How it works</h2>
        <ol class="flex flex-col gap-6 mt-10">
          {
            steps.map((step, index) => (
              <li class="bg-card rounded-2xl border p-8 flex gap-6">
                <span class="text-3xl font-semibold text-foreground/40 shrink-0">{index + 1}</span>
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl font-semibold">{step.title}</h3>
                  <p class="text-sm text-foreground/70 leading-relaxed">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="flex flex-col items-center text-center mt-14">
          <p class="text-foreground/75 max-w-xl">
            If the report says a rebuild is not worth your money, we will tell you that too. You can see what a new
            site costs on our <a href="/services/#pricing" class="text-[#6eaaff] underline underline-offset-2">services page</a>.
          </p>
          <a
            href="/contact/?subject=Free+Website+Audit"
            class="inline-flex items-center gap-2 h-12 px-6 mt-8 rounded-full ring-1 ring-white/15 hover:ring-white/30 hover:bg-white/5 transition-colors font-semibold text-foreground"
          >
            <span>Claim My Free Audit</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
