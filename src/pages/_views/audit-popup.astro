---
import { XIcon } from "lucide-react";
---

<div
  id="audit-popup"
  class="hidden fixed inset-0 z-[100] items-center justify-center px-4 opacity-0 transition-opacity duration-300"
  data-state="hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="audit-popup-title"
>
  <div id="audit-popup-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div
    class="relative w-full max-w-md bg-card border border-white/10 rounded-2xl p-8 shadow-2xl"
    style="background: radial-gradient(circle at top right, rgba(194,87,255,0.15), transparent 60%), hsl(var(--card));"
  >
    <button
      id="audit-popup-close"
      class="absolute top-4 right-4 h-9 w-9 inline-flex items-center justify-center rounded-full text-foreground/60 hover:text-foreground hover:bg-white/10 transition-colors"
      aria-label="Close"
    >
      <XIcon className="h-5 w-5" />
    </button>

    <div class="flex flex-col items-center text-center gap-4">
      <span class="text-[0.625rem] font-bold tracking-wider bg-[#03cc00] text-background px-3 py-1 rounded-full">
        LIMITED TIME PROMOTION
      </span>

      <h2 id="audit-popup-title" class="text-2xl sm:text-3xl font-semibold leading-tight">
        Get a free website audit
      </h2>

      <div class="flex items-baseline justify-center gap-3 mt-1">
        <span class="text-foreground/40 text-2xl line-through">$650</span>
        <span class="text-4xl sm:text-5xl font-bold text-[#c257ff]">$0</span>
      </div>

      <p class="text-foreground/75 text-base leading-relaxed">
        No hidden charges. No pressure to pay. We'll review your site and send back a detailed report on what's working and what could be better.
      </p>

      <div class="relative group/button w-full mt-2">
        <div
          class="absolute transition-all duration-150 opacity-0 inset-px bg-[#c257ff] rounded-xl blur-lg group-hover/button:opacity-60 group-hover/button:-inset-px group-hover/button:duration-300 z-0"
        >
        </div>
        <a
          href="/contact?subject=Free+Website+Audit"
          class="h-14 w-full inline-flex items-center justify-center px-10 py-2 bg-[#c257ff] font-semibold rounded-full text-background relative z-10"
        >
          Claim My Free Audit
        </a>
      </div>

      <button id="audit-popup-dismiss" class="text-foreground/50 hover:text-foreground/80 transition-colors text-sm mt-1">
        No thanks
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "audit-popup-shown";
  const DELAY_MS = 30_000;

  const popup = document.getElementById("audit-popup");
  const backdrop = document.getElementById("audit-popup-backdrop");
  const closeBtn = document.getElementById("audit-popup-close");
  const dismissBtn = document.getElementById("audit-popup-dismiss");

  if (popup && sessionStorage.getItem(STORAGE_KEY) !== "1") {
    const show = () => {
      popup.classList.remove("hidden");
      popup.classList.add("flex");
      requestAnimationFrame(() => {
        popup.classList.remove("opacity-0");
        popup.dataset.state = "visible";
      });
      document.body.style.overflow = "hidden";
    };

    const hide = () => {
      popup.classList.add("opacity-0");
      popup.dataset.state = "hidden";
      sessionStorage.setItem(STORAGE_KEY, "1");
      document.body.style.overflow = "";
      setTimeout(() => {
        popup.classList.add("hidden");
        popup.classList.remove("flex");
      }, 300);
    };

    setTimeout(show, DELAY_MS);

    closeBtn?.addEventListener("click", hide);
    dismissBtn?.addEventListener("click", hide);
    backdrop?.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && popup.dataset.state === "visible") hide();
    });
  }
</script>
