    line-height: 1.8;
  }
  .article-prose h2 {
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: hsl(var(--foreground));
  }
  .article-prose p {
    margin-bottom: 1.25rem;
  }
  .article-prose ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
