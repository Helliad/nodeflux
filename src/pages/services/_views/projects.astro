---
import { MaskedHeading } from "@/components/typography/masked-heading";
import { DeliveredProjects } from '@/pages/services/_components/projects'
---

<section id="projects" class="mt-40">
  <div class="container">
    <div class="flex flex-col gap-3.5 max-w-2xl mx-auto">
      <MaskedHeading className="leading-[1.15]">What We Deliver</MaskedHeading>
      <p class="text-xl text-foreground/75 text-center">A glimpse of the kind of work we build for businesses across Singapore and beyond. Get in touch to see more.</p>
    </div>
    <DeliveredProjects client:load />
  </div>
</section>
